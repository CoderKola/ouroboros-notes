{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "/bin/bash \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/session-start.sh", "timeout": 10 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "/bin/bash \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/stop.sh", "timeout": 10 }] }
    ],
    "PreCompact": [
      { "hooks": [{ "type": "command", "command": "/bin/bash \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/pre-compact.sh", "timeout": 10 }] }
    ]
  }
}
